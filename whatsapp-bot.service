[Unit]
Description=Painel Netsimon - WhatsApp Notification Microservice (Baileys)
After=network.target netsimon-painel.service

[Service]
Type=simple
WorkingDirectory=/etc/painel
ExecStart=/usr/bin/node /etc/painel/whatsapp_bot.js
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
